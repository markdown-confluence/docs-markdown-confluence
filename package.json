{
  "name": "markdown-confluence-website",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev --host 0.0.0.0",
    "build": "vp run typecheck && vp build && node scripts/build-route-files.mjs",
    "typecheck": "tsc --noEmit",
